# Credenciais do Supabase (Project Settings > API no dashboard).
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# A anon key é pública (client-side) e protegida por Row Level Security.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# Assinatura (Mercado Pago): deixe "true" só depois de configurar o pagamento.
# Com "false" (ou vazio) o app funciona sem paywall.
VITE_BILLING_ENABLED=false

# (Opcional) Link de pagamento público do Mercado Pago (mpago.la/...). Se
# preenchido, o botão "Assinar" abre esse link direto (não é segredo).
# Deixe vazio para usar o fluxo por Edge Function (plano + API).
VITE_MP_CHECKOUT_URL=

# Integração Uber: "true" mostra o card "Conectar com Uber" na tela de
# Receitas. Só ligue depois de publicar as Edge Functions uber-* e ter o
# app aprovado pela Uber. Com "false" (ou vazio) o card fica oculto.
VITE_UBER_ENABLED=false

# (Opcional) Chave do Google Maps/Places para nomes de posto melhores ao
# abastecer. Sem ela, o app usa o OpenStreetMap (grátis, sem chave). A chave
# é pública (vai no client) — RESTRINJA por referer HTTP e habilite só a
# "Places API (New)" no Google Cloud. Exige faturamento/cartão no Google.
VITE_GOOGLE_MAPS_API_KEY=

# (Opcional) Foursquare para nomes de posto (grátis, SEM cartão). Defina
# "true" para o app buscar os postos pela Edge Function "nearby-stations"
# (a chave FOURSQUARE_API_KEY fica SECRETA no Supabase, não vai no app).
# Com "false" (ou vazio) usa o OpenStreetMap.
VITE_FOURSQUARE_ENABLED=false
