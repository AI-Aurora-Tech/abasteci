# Credenciais do Supabase (Project Settings > API no dashboard).
# Copie este arquivo para ".env" e preencha com os valores do seu projeto.
# A anon key é pública (client-side) e protegida por Row Level Security.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key
