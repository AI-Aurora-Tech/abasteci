# Segredos das Edge Functions (Mercado Pago).
# 1) Copie este arquivo para  supabase/functions/.env.secrets
# 2) Preencha os valores (o .env.secrets NÃO é versionado — está no .gitignore)
# 3) Rode: scripts/setup-mercadopago.ps1  (Windows)  ou  scripts/setup-mercadopago.sh
#
# MP_ACCESS_TOKEN: Access Token de PRODUÇÃO (Mercado Pago > Suas integrações > Credenciais).
# MP_PREAPPROVAL_PLAN_ID: id do plano criado com scripts/create-mp-plan.*
# APP_URL: URL pública do app (para onde o checkout volta).

MP_ACCESS_TOKEN=COLE_SEU_ACCESS_TOKEN_AQUI
MP_PREAPPROVAL_PLAN_ID=COLE_O_ID_DO_PLANO_AQUI
APP_URL=https://SEU-APP

# --- Integração Uber (opcional) ---
# Do painel developer.uber.com (o CLIENT_SECRET é secreto).
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# URL da função de callback (cadastre a MESMA como Redirect URI no app da Uber):
UBER_REDIRECT_URI=https://anigjrfbsdtcjsdqukhl.supabase.co/functions/v1/uber-oauth
